{
  "subject": "Quantitative Reasoning",
  "topic": "Data Interpretation",
  "introduction": "Data Interpretation requires reading charts (bar, pie, line) and tables to answer quantitative questions. Key skills: calculating percentage change, reading approximate values, comparing categories, identifying trends, and computing totals/averages from data.",
  "key_formulas": [
    {"name": "Percentage change", "formula": "\\%\\text{ change} = \\frac{\\text{New} - \\text{Old}}{\\text{Old}} \\times 100"},
    {"name": "Percentage of total", "formula": "\\% = \\frac{\\text{Part}}{\\text{Total}} \\times 100"},
    {"name": "Average", "formula": "\\bar{x} = \\frac{\\sum x_i}{n}"},
    {"name": "Ratio from pie chart", "formula": "\\text{Value} = \\frac{\\text{Angle}}{360°} \\times \\text{Total}"},
    {"name": "Bar chart reading", "formula": "\\text{Read height from y-axis scale carefully}"}
  ],
  "tips_and_tricks": [
    "Always identify the unit (thousands, millions, %) before computing.",
    "For percentage change: use (New - Old)/Old × 100. Sign indicates increase/decrease.",
    "For pie charts: each degree = 1/360 of total. Each 1% = 3.6°.",
    "Read bar charts by projecting tops to the y-axis — don't estimate by eye alone.",
    "For multiple series bar charts: be sure to read the correct bar within each group.",
    "Trend lines: focus on direction (up/down) and rate (steep vs. gradual).",
    "Cross-check your answer with magnitude: does it make sense given the chart scale?"
  ],
  "worked_examples": [
    {
      "title": "Example 1: Bar chart — percentage change",
      "question": "A bar chart shows Company A's revenue: 2021=400M, 2022=500M. What is the percentage increase?",
      "solution": [
        "Step 1: Identify Old=400M, New=500M.",
        "Step 2: Change = 500-400 = 100M.",
        "Step 3: % change = (100/400) × 100 = 25%.",
        "Step 4: Revenue grew by 25%."
      ]
    },
    {
      "title": "Example 2: Pie chart — category value",
      "question": "A pie chart shows total budget = 500M. Education sector = 30%. What is the education budget?",
      "solution": [
        "Step 1: Education % = 30%.",
        "Step 2: Value = 30% × 500M = 0.30 × 500 = 150M.",
        "Step 3: Education budget = 150 million."
      ]
    }
  ],
