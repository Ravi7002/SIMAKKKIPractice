              187.5
            ]
          },
          {
            "label": "Stock Y",
            "values": [
              100,
              125,
              150,
              187.5
            ]
          }
        ]
      },
      "hints": [
        "Let initial value = 100.",
        "Yr1 X = 100 + 150% = 250 (which is 2.",
        "5 times - D is True)."
      ]
