    {
      "id": "dic_hard_1",
      "subject": "Quantitative Reasoning",
      "topic": "Data Interpretation and Charts",
      "difficulty": "hard",
      "question_text": "In a survey table for school activities, 20% of Club A members are seniors, while 50% of Club B members are seniors. Together, the two clubs have 200 members in total, and 32% of all completely pooled members are seniors. Assuming nobody is in both clubs, how many members are in Club A?",
      "options": [
        {
          "letter": "A",
          "text": "120"
        },
        {
          "letter": "B",
          "text": "100"
        },
        {
          "letter": "C",
          "text": "60"
        },
        {
          "letter": "D",
          "text": "80"
        },
        {
          "letter": "E",
          "text": "150"
        }
      ],
      "correct_answer": "A",
      "explanation": "Let A be the members in Club A and B be members in Club B. \nA + B = 200 → B = 200 - A. \nSeniors in A + Seniors in B = Total Seniors. \n0.20*A + 0.50*(200 - A) = 0.32 * 200. \n0.20A + 100 - 0.50A = 64 → -0.30A = -36 → A = 36 / 0.30 = 120.",
      "chart_data": {
        "type": "table",
        "title": "Survey Data",
        "headers": [
          "Group",
          "Members",
          "Seniors%"
        ],
        "rows": [
