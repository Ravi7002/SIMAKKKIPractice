          "text": "$1200"
        },
        {
          "letter": "B",
          "text": "$800"
        },
        {
          "letter": "C",
          "text": "$400"
        },
        {
          "letter": "D",
          "text": "$1000"
        },
        {
          "letter": "E",
          "text": "$600"
        }
      ],
      "correct_answer": "A",
      "explanation": "Total percentage for Rent and Food = 40% + 20% = 60%. \n60% of $2000 = 0.60 * 2000 = $1200.",
      "chart_data": {
        "type": "pie",
        "title": "Distribution",
        "labels": [
