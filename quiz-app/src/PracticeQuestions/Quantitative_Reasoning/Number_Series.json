  "subject": "Quantitative Reasoning",
  "topic": "Number Series",
  "introduction": "Number series questions in SIMAK present a sequence with one missing term. Unlike pure logic sequences, quantitative series often involve arithmetic, geometric, or composite operations on specific values. Master identifying the rule quickly under exam conditions.",
  "key_formulas": [
    {"name": "Arithmetic", "formula": "a_n = a_1 + (n-1)d"},
    {"name": "Geometric", "formula": "a_n = a_1 \\cdot r^{n-1}"},
    {"name": "Sum of AP", "formula": "S_n = \\frac{n}{2}(a_1 + a_n)"},
    {"name": "Second difference (quadratic)", "formula": "\\text{If 2nd differences are constant, the rule is quadratic}"},
    {"name": "Alternating series", "formula": "\\text{Separate odd/even indexed terms — each forms its own pattern}"}
  ],
  "tips_and_tricks": [
    "Step 1: Compute consecutive differences. Constant → arithmetic.",
    "Step 2: If not constant, compute ratios. Constant → geometric.",
    "Step 3: If differences form an AP → quadratic sequence.",
    "Step 4: If none work, try alternating: separate odd-indexed and even-indexed terms.",
    "Common patterns: n², n³, n(n+1), n²+1, primes, Fibonacci.",
    "Work quickly: eliminate options by checking just the last 2 known terms."
  ],
  "worked_examples": [
    {
      "title": "Example 1: Quadratic sequence",
      "question": "3, 8, 15, 24, 35, ?",
      "solution": [
        "Step 1: Differences = 5, 7, 9, 11 (AP with d=2, second differences = 2).",
        "Step 2: Next difference = 11+2 = 13.",
        "Step 3: Next term = 35+13 = 48.",
        "Formula check: n²+2n → 1+2=3 ✓, 4+4=8 ✓, 9+6=15 ✓"
      ]
    },
    {
      "title": "Example 2: Mixed operation series",
      "question": "1, 2, 6, 24, 120, ?",
      "solution": [
        "Step 1: Ratios: ×2, ×3, ×4, ×5.",
        "Step 2: Each ratio increases by 1.",
        "Step 3: Next ratio: ×6. Next term: 120×6 = 720.",
        "Pattern: n! (factorials): 1!, 2!, 3!, 4!, 5!, 6! = 720."
      ]
    }
  ],
